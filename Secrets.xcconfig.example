// Copy this file to `Secrets.xcconfig` (gitignored) and fill in values.
// `Secrets.xcconfig` is consumed by project.yml as the app target's base config.
//
// TWO WAYS TO SUPPLY THE CLAUDE API KEY
//
//  1. RECOMMENDED — enter it in the app: Settings ▸ "Claude API key" ▸ Save.
//     Stored only in that device's Keychain. Never in git, never in the app
//     bundle. Use "Test Claude connection" there to verify it.
//
//  2. DEV CONVENIENCE — set ANTHROPIC_API_KEY below. It is injected into the
//     Debug Info.plist so the simulator/dev build has a key without typing it
//     each launch. It is BLANK for Release builds (see the [config=Release]
//     line) so a shipped build never carries the key. The Keychain value from
//     option 1 always takes priority over this.

ANTHROPIC_API_KEY =
ANTHROPIC_API_KEY[config=Release] =

// From the Wearables Developer Center app registration.
// With Meta AI Developer Mode enabled, META_APP_ID = 0 and CLIENT_TOKEN blank is fine.
META_APP_ID = 0
CLIENT_TOKEN =

// Apple Developer Team ID (Xcode ▸ Settings ▸ Accounts). Personal Team works for
// development installs. Needed for on-device builds; leave blank for simulator.
DEVELOPMENT_TEAM =
