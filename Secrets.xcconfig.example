// Copy this file to `Secrets.xcconfig` (which is gitignored) and fill in values.
// `Secrets.xcconfig` is consumed by project.yml as the target's base config file.

// Anthropic API key used for dev builds. In-app Settings (Keychain) overrides this
// at runtime, so it can be left blank if you enter the key on-device.
ANTHROPIC_API_KEY =

// From the Wearables Developer Center app registration.
// Use 0 for META_APP_ID when running with Meta AI Developer Mode.
META_APP_ID = 0
CLIENT_TOKEN =

// Your Apple Developer Team ID (Signing & Capabilities).
DEVELOPMENT_TEAM =

// Note: xcconfig cannot contain `//` inside a value (it starts a comment).
// The Info.plist reads ANTHROPIC_API_KEY via $(ANTHROPIC_API_KEY).
